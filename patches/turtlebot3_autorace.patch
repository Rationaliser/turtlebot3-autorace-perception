+# Node is launched as /detect_level_crossing and declares detect.level.red.* parameters,
+# so the YAML must use that node name and nesting (the original /detect_level + red.* never loaded).
+# Thresholds tuned on the Gazebo barrier: red stripes measured at H 0-1, S ~232 (1st pct 150), V ~210 (1st pct 165).
+/detect_level_crossing:
+  ros__parameters:
+    detect:
+      level:
+        red:
+          hue_l: 0
+          hue_h: 10
+          saturation_l: 140
+          saturation_h: 255
+          lightness_l: 120
+          lightness_h: 255
